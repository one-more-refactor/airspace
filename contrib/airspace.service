[Unit]
Description=airspace — passive radio observatory (collector)
Documentation=https://github.com/one-more-refactor/airspace
# Bluetooth only. The Wi-Fi ear is a separate unit precisely because it needs a
# capability this one does not.
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
# 0.0.0.0 rather than loopback, because the remote ears have to reach it and a
# DHCP lease makes a fixed bind fragile. Note what this exposes: /api/state and
# the map are NOT authenticated, so anyone who can reach this port can see the
# devices around you. Only /ingest is token-checked. On a trusted LAN that is a
# considered trade; in front of a flat tailnet it is worth a second thought.
ExecStart=%h/.local/bin/airspace serve 0.0.0.0:9970
Restart=on-failure
RestartSec=3

# It reads one D-Bus service and serves one loopback port. Nothing it does
# needs a filesystem it can write to, a new privilege, or a second address
# family — so it gets none of them.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
